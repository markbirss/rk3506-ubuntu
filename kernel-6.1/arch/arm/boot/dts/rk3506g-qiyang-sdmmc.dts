/dts-v1/;

#include "rk3506-luckfox-lyra-ultra.dtsi"

/ {
	model = "Qiyang RK3506B(STAMP) Kit";
	compatible = "rockchip,rk3506g-demo-display-control", "rockchip,rk3506";

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0xff0a0000 console=tty1 console=ttyFIQ0 storagemedia=sd root=/dev/mmcblk0p3 rootfstype=ext4 rootwait snd_aloop.index=7 snd_aloop.use_raw_jiffies=1";
	};

	acodec_sound: acodec-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rockchip,acodec";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <1024>;
		simple-audio-card,bitclock-master = <&codec_master>;
		simple-audio-card,frame-master = <&codec_master>;
		simple-audio-card,cpu {
			sound-dai = <&sai4>;
		};
		codec_master: simple-audio-card,codec {
			sound-dai = <&audio_codec>;
		};
	};

	adc_keys: adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;
		status = "disabled";
		vol-up-key {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <16000>;
		};

		vol-down-key {
			label = "volume down";
			linux,code = <KEY_VOLUMEDOWN>;
			press-threshold-microvolt = <420000>;
		};

		menu-key {
			label = "menu";
			linux,code = <KEY_MENU>;
			press-threshold-microvolt = <800000>;
		};

		esc-key {
			label = "esc";
			linux,code = <KEY_ESC>;
			press-threshold-microvolt = <1200000>;
		};
	};

	dsm_sound: dsm-sound {
		status = "disabled";
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,name = "rockchip,dsm-sound";
		simple-audio-card,bitclock-master = <&sndcodec>;
		simple-audio-card,frame-master = <&sndcodec>;
		sndcpu: simple-audio-card,cpu {
			sound-dai = <&sai3>;
		};
		sndcodec: simple-audio-card,codec {
			sound-dai = <&acdcdig_dsm>;
		};
	};

	es8388_sound: es8388-sound {
		status = "disabled";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip-es8388";
		spk-con-gpio = <&gpio1 RK_PB7 GPIO_ACTIVE_HIGH>;
		rockchip,pre-power-on-delay-ms = <30>;
		rockchip,post-power-down-delay-ms = <40>;
		rockchip,format = "i2s";
		rockchip,mclk-fs = <256>;
		rockchip,cpu = <&sai2>;
		rockchip,codec = <&es8388>;
		rockchip,audio-routing =
			"Speaker", "LOUT2",
			"Speaker", "ROUT2",
			"Speaker", "Speaker Power",
			"Speaker", "Speaker Power",
			"LINPUT1", "Main Mic",
			"RINPUT1", "Main Mic";
		pinctrl-names = "default";
		pinctrl-0 = <&spk_ctrl>;
	};

	fiq_debugger: fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		rockchip,serial-id = <0>;
		rockchip,wake-irq = <0>;
		rockchip,irq-mode-enable = <1>;
		rockchip,baudrate = <1500000>;	/* Only 115200 and 1500000 */
		interrupts = <GIC_SPI 115 IRQ_TYPE_LEVEL_HIGH>;
	};

	leds: leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpio_led>;

		run_led: run {
			label = "led_run";
			gpios = <&gpio0 RK_PD0 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
			default-state = "off";
		};
	};

	vcc5v0_otg0: vcc5v0-otg0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_otg0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio1 RK_PA0 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_otg0_en>;
	};

	vcc5v0_5V: vcc5v0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_5V";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
        regulator-always-on;
		regulator-boot-on;
	};

	spk_pwren: spk_pwren-regulator {
		compatible = "regulator-fixed";
		regulator-name = "spk_pwren";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio1 RK_PC0 GPIO_ACTIVE_HIGH>;
		enable-active-high;
        regulator-always-on;
		regulator-boot-on;
	};

	pwr4g_3v3: pwr4g_3v3-regulator {
		compatible = "regulator-fixed";
		regulator-name = "pwr4g_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio1 RK_PA4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
        regulator-always-on;
		regulator-boot-on;
	};

	hub_4g_wifi_gpio {
		compatible = "qiyang,qiyang_usb";
		pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_hub_4g>;
		reset-gpios = <&gpio1 RK_PA1 GPIO_ACTIVE_LOW>;
		reset-4g-gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_LOW>;
		wifi-tf-gpios = <&gpio1 RK_PC4 GPIO_ACTIVE_HIGH>;    //wifi swich tf   wifi_io swich uart 
		reset-duration = <20>;
		status = "okay";
	};

	wifi_on: wifi_on-regulator {
		compatible = "regulator-fixed";
		regulator-name = "wifi_on";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&gpio1 RK_PC6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
        regulator-always-on;
		regulator-boot-on;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
	};

	wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <&grf>;
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_wake_host>;
		wifi_chip_type = "ap6256";
		WIFI,host_wake_irq = <&gpio1 RK_PC5 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <&gpio1 RK_PD1 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <&uart5m1_rtsn_pins>;
		pinctrl-1 = <&uart5_gpios>;
		BT,power_gpio    = <&gpio1 RK_PD0 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

};

&audio_codec {
	status = "okay";
};

&cma {
	size = <0x1600000>;
};

&dsi {
	status = "okay";
};

&dsi_dphy {
	status = "okay";
};

&dsi_in_vop {
	status = "okay";
};

&pinctrl {
	usb {
		vcc5v0_otg0_en: vcc5v0-otg0-en {
			rockchip,pins = <1 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};

	};

	hub-4g-reset {
       pinctrl_hub_4g: pinctrl_hub_4g-reset{
           rockchip,pins =
		<1 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>,
			<1 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
       };
	};

	leds {
		pinctrl_gpio_led: pinctrl_gpio_led {
			rockchip,pins = <0 RK_PD0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
		
	sdio-pwrseq {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <1 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wireless-wlan {
		wifi_wake_host: wifi-wake-host {
			rockchip,pins = <1 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	wireless-bluetooth {
		uart5_gpios: uart5-gpios {
			rockchip,pins = <1 RK_PD1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
    touch {
        touch_gpio: touch-gpio {
            rockchip,pins = <1 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>,
                            <1 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
        };
    };

	watchdog{
        gpio_dog_pin: gpio_dog_pin{
            rockchip,pins = <1 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
               };
    };

	speaker {
		spk_ctrl: spk-ctrl {
			rockchip,pins = <1 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&mdio0 {
	rmii_phy0: phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x0>;
		clocks = <&cru CLK_MAC_OUT>;
	};
};

&gmac0 {
	phy-mode = "rmii";
	clock_in_out = "input";

	snps,reset-gpio = <&gpio0 RK_PA1 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&eth_rmii0_miim_pins
		     &eth_rmii0_tx_bus2_pins
		     &eth_rmii0_rx_bus2_pins
		     &eth_rmii0_clk_pins
			 &eth_clk1_25m_out_pins>;

	phy-handle = <&rmii_phy0>;
	status = "okay";
};

&gmac1 {
	phy-mode = "rmii";
	clock_in_out = "input";

	snps,reset-gpio = <&gpio4 RK_PB2 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 1000000>;

	pinctrl-names = "default";
	pinctrl-0 = <&eth_rmii1_miim_pins
		     &eth_rmii1_tx_bus2_pins
		     &eth_rmii1_rx_bus2_pins
		     &eth_rmii1_clk_pins
			 &eth_clk0_25m_out_pins>;

	phy-handle = <&rmii_phy1>;
	status = "okay";
};

&mdio1 {
	rmii_phy1: phy@3 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x3>;
		clocks = <&cru CLK_MAC_OUT>;
	};
};
&route_dsi {
	status = "okay";
};

&sai1 {
	status = "disabled";
};

&u2phy_otg0 {
	vbus-supply = <&vcc5v0_otg0>;
	status = "okay";
};

&u2phy_otg1 {
	status = "okay";
};

&can0 {
	pinctrl-names = "default";
    pinctrl-0 = <&rm_io13_can0_tx &rm_io12_can0_rx>;
	status = "okay";
};

&can1 {
	pinctrl-names = "default";
    pinctrl-0 = <&rm_io15_can1_tx &rm_io14_can1_rx>;
	status = "okay";
};

&i2c2 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io16_i2c2_sda &rm_io17_i2c2_scl>;
	status = "okay";

	es8388: es8388@11 {
		status = "disabled";
		#sound-dai-cells = <0>;
		compatible = "everest,es8388", "everest,es8323";
		reg = <0x11>;
		clocks = <&mclkout_sai2>;
		clock-names = "mclk";
		assigned-clocks = <&mclkout_sai2>;
		assigned-clock-rates = <12288000>;
		pinctrl-names = "default";
		pinctrl-0 = <&sai2m1_mclk_pins>;
	};

	rtc_pc8563: pc8563@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
		clock-output-names = "rtc_32k";
		status = "okay";
    };
};


&es8388 {
        status = "okay";
};

&es8388_sound {
        status = "okay";
};


&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io10_uart1_tx &rm_io9_uart1_rx>;
	rs485-de-gpios = <&gpio0 RK_PB3 GPIO_ACTIVE_HIGH>;
	linux,rs485-enabled-at-boot-time;
	rs485-rts-active-low;
	status = "okay";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io7_uart2_tx &rm_io6_uart2_rx>;
	rs485-de-gpios = <&gpio0 RK_PB0 GPIO_ACTIVE_HIGH>;
	linux,rs485-enabled-at-boot-time;
	rs485-rts-active-low;
	status = "okay";
};

&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io5_uart3_tx &rm_io4_uart3_rx>;
	status = "okay";
};

&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io3_uart4_tx &rm_io0_uart4_rx>;
	status = "okay";
};

&uart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart5m1_xfer_pins &uart5m1_ctsn_pins>;
	status = "okay";
};

&fspi {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <80000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

&mmc {
	no-mmc;
	supports-sd;
	//no-sd;
	max-frequency = <140000000>;
	cap-sd-highspeed;
	disable-wp;
	cd-gpios = <&gpio1 RK_PB5 GPIO_ACTIVE_LOW>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk_pins &sdmmc_cmd_pins &sdmmc_bus4_pins &sdmmc_det>;
};

&pinctrl {
	sdmmc {
		sdmmc_det: sdmmc-det {
			rockchip,pins = <1 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	// gpio-keys {
	// 	key_wake_up: key-wake-up {
	// 		rockchip,pins = <0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
	// 	};
	// };

	// sdio-pwrseq {
	// 	wifi_enable_h: wifi-enable-h {
	// 		rockchip,pins = <0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
	// 	};
	// };

	speaker {
		spk_ctrl: spk-ctrl {
			rockchip,pins = <1 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	// wireless-bluetooth {
	// 	uart5_gpios: uart5-gpios {
	// 		rockchip,pins = <3 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
	// 	};
	// };

	// wireless-wlan {
	// 	wifi_wake_host: wifi-wake-host {
	// 		rockchip,pins = <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>;
	// 	};
	// };

};

&pwm0_4ch_0 {
	pinctrl-names = "active";
	pinctrl-0 = <&rm_io21_pwm0_ch0>;
	status = "okay";
};

&pwm0_4ch_1 {
	pinctrl-names = "active";
	pinctrl-0 = <&rm_io20_pwm0_ch1>;
	status = "okay";
};

&pwm0_4ch_2 {
	pinctrl-names = "active";
	pinctrl-0 = <&rm_io18_pwm0_ch2>;
	status = "okay";
};

&rga2 {
	status = "okay";
};

&rng {
	status = "okay";
};

&rockchip_suspend {
	rockchip,sleep-mode-config = <
		(0
		| RKPM_ARMOFF_DDRPD
		| RKPM_24M_OSC_DIS
		| RKPM_32K_CLK
		| RKPM_32K_SRC_RC
		| RKPM_PWM0_CH0_REGULATOR
		)
	>;

	rockchip,apios-suspend = <
		(0
		| RKPM_PWREN_CORE_GPIO0A2 | RKPM_PWREN_CORE_ACT_LOW
		| RKPM_PWREN_SLEEP_GPIO0A0 | RKPM_PWREN_SLEEP_ACT_LOW
		)
	>;

#define GPIO0_IOC_GPIO0A_PULL_REG	0xff950200
#define GPIO0_IOC_GPIO0B_PULL_REG	0xff950204
#define GPIO0_IOC_GPIO0C_PULL_REG	0xff950208
#define IOC0_GPIO0C5_SMT_REG		0xff950408

#define GPIO0A02_PULL_Z			0x00330000
#define GPIO0A3_PULL_DOWN		0x00c00080
#define GPIO0B0_PULL_DOWN		0x00030002
#define GPIO0C5_PULL_Z			0x0c000000
#define GPIO0C5_SMT_DISABLE		0x00200000

	/* Note: support max 16 pairs */
	rockchip,sleep-io-config = <
		GPIO0_IOC_GPIO0C_PULL_REG GPIO0C5_PULL_Z    /* PWM0_CH0_CPU */
		IOC0_GPIO0C5_SMT_REG GPIO0C5_SMT_DISABLE    /* PWM0_CH0_CPU */
		GPIO0_IOC_GPIO0A_PULL_REG GPIO0A02_PULL_Z   /* PWRCTRL0, PWRCTRL1 */
		GPIO0_IOC_GPIO0A_PULL_REG GPIO0A3_PULL_DOWN /* PWM0_CH2_LCD_BL */
		GPIO0_IOC_GPIO0B_PULL_REG GPIO0B0_PULL_DOWN /* SAI1_MCLK */
	>;
};

&sai2{
	pinctrl-names = "default";
	pinctrl-0 = <&sai2m1_lrck_pins
			     &sai2m1_sclk_pins
			     &sai2m1_sdi_pins
			     &sai2m1_sdo_pins>;
	status = "okay";
};


&sai4 {
	status = "okay";
};

&saradc {
	vref-supply = <&vcc_1v8>;
	status = "disabled";
};

&tsadc {
	status = "okay";
};
